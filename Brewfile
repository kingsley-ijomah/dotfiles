# Homebrew Bundle - https://github.com/Homebrew/homebrew-bundle
# Install: brew bundle --file=~/dotfiles/Brewfile

# ======================
# Core Tools
# ======================
brew "zsh"                    # Shell
brew "neovim"                 # Editor
brew "tmux"                   # Terminal multiplexer
brew "git"                    # Version control

# ======================
# CLI Utilities
# ======================
brew "ripgrep"                # Fast grep (for telescope)
brew "fd"                     # Fast find (for telescope)
brew "fzf"                    # Fuzzy finder
brew "gh"                     # GitHub CLI (used in your git aliases)
brew "curl"                   # HTTP client
brew "wget"                   # HTTP client
brew "jq"                     # JSON processor
brew "tree"                   # Directory listing

# ======================
# Development
# ======================
brew "node"                   # Node.js (for LSP servers)
brew "python"                 # Python 3

# ======================
# Fonts (for terminal/neovim icons)
# ======================
cask "font-meslo-lg-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono-nerd-font"

